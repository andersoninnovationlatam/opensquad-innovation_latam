# Instagram Graph API — https://developers.facebook.com/docs/instagram-api/
# Requires an Instagram Business account connected to a Facebook Page.
# Get your token from: Meta for Developers → Graph API Explorer
# Required scope: instagram_content_publish

INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id_here

# Image hosting for instagram-publisher (Instagram fetches these URLs)
# Default: catbox (no key). If imgBB URLs fail with Instagram error 9004, keep catbox or use imgur.
# INSTAGRAM_IMAGE_HOST=catbox
# INSTAGRAM_IMAGE_HOST=imgbb   # requires IMGBB_API_KEY
# INSTAGRAM_IMAGE_HOST=imgur   # requires IMGUR_CLIENT_ID (https://api.imgur.com/oauth2/addclient

# IMGBB_API_KEY=your_imgbb_api_key_here
# IMGUR_CLIENT_ID=your_imgur_client_id_here

# Google Chat — incoming webhook URL (space → Integrations → Webhooks). Never commit the real URL.
# If exposed, delete the webhook in Chat and create a new one.
# Webhook URLs contain & — use single quotes or load with: node --env-file=.env
# GOOGLE_CHAT_WEBHOOK_URL='https://chat.googleapis.com/v1/spaces/SPACE/messages?key=...&token=...'

# Google Drive — upload PNGs/JPEGs para uma pasta por run.
# Service account JSON NÃO deve ser commitado. Use a pasta local `secrets/`.
# Como obter: Google Cloud Console → IAM → Service Accounts → criar conta → baixar JSON
# Compartilhe a pasta pai do Drive com o email da service account (editor).
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=secrets/google-drive-service-account.json
# GOOGLE_DRIVE_PARENT_FOLDER_ID=1YB6Qt7-NoI62HU-4v_R-qZpHMNOhANB3

# OpenRouter — API para geração de imagens e conteúdo via LLMs
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modelo de geração de imagens (production) — usado por image-ai-generator e carousel-noticias
# Padrão: google/gemini-3.1-flash-image-preview
# Outros: google/gemini-2.5-flash-image, black-forest-labs/flux-1.1-pro, etc.
# OPENROUTER_MODELS_IMAGE=google/gemini-3.1-flash-image-preview

# Modelo de geração de imagens (test/iteração) — mais barato, para rascunhos
# Padrão: sourceful/riverflow-v2-fast
# OPENROUTER_MODELS_IMAGE_TEST=sourceful/riverflow-v2-fast

# Modelo de geração de texto — usado por squads com geração de conteúdo via API direta
# Padrão: anthropic/claude-sonnet-4-6
# OPENROUTER_MODELS_TEXT=anthropic/claude-sonnet-4-6

