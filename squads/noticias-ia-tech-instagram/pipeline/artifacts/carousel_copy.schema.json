{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "squads/noticias-ia-tech-instagram/pipeline/artifacts/carousel_copy.schema.json",
  "title": "CarouselCopy",
  "description": "Emitido em squads/noticias-ia-tech-instagram/output/{run_id}/carousel_copy.json",
  "type": "object",
  "required": ["meta", "slides"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source_url", "source_label", "tone"],
      "properties": {
        "source_url": { "type": "string", "format": "uri" },
        "source_label": { "type": "string" },
        "tone": { "type": "string", "description": "Tom escolhido de tone-of-voice.md" },
        "caption_full": {
          "type": "string",
          "description": "Legenda completa do post (única) para copiar no Instagram"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["slide_number", "slide_text", "caption_text"],
        "properties": {
          "slide_number": { "type": "integer", "minimum": 1, "maximum": 5 },
          "slide_text": {
            "type": "string",
            "description": "Overlay: manchete curta (máx. ~10 palavras)"
          },
          "caption_text": {
            "type": "string",
            "description": "Bloco de legenda associado ao slide ou notas; slide 5 pode repetir CTA da legenda"
          }
        }
      }
    }
  }
}
