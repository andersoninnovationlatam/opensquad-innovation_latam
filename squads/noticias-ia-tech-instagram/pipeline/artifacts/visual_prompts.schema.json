{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "squads/noticias-ia-tech-instagram/pipeline/artifacts/visual_prompts.schema.json",
  "title": "VisualPrompts",
  "description": "Emitido em squads/noticias-ia-tech-instagram/output/{run_id}/visual_prompts.json",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["slide_number", "image_prompt", "text_overlay"],
        "properties": {
          "slide_number": { "type": "integer", "minimum": 1 },
          "image_prompt": {
            "type": "string",
            "description": "Apenas cenário/fundo; sem texto nem URLs na imagem"
          },
          "text_overlay": {
            "type": "string",
            "description": "Manchete a compor por script (deve coincidir com carousel_copy)"
          }
        }
      }
    }
  }
}
